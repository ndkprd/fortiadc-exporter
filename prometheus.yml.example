scrape_configs:
  - job_name: fortiadc
    metrics_path: /probe
    scrape_interval: 1m
    scrape_timeout: 30s
    static_configs:
      - targets: [adc-01.example.com]   # key under `fortiadc:` in config.yml
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: fortiadc-exporter:9634

  - job_name: fortiadc-exporter
    static_configs:
      - targets: [fortiadc-exporter:9634]
