        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${PROMETHEUS_DS}"
        },
        "query": "label_values(fortiadc_up, job)",
        "definition": "label_values(fortiadc_up, job)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "regex": "",
        "options": [],
        "skipUrlSync": false,
        "current": {
          "selected": true,
