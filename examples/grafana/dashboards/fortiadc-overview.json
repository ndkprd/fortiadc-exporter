{
  "id": null,
  "uid": "fortiadc-overview",
  "title": "FortiADC Overview",
  "description": "Health and traffic of FortiADC appliances scraped through fortiadc-exporter /probe: are the devices reachable, are virtual servers healthy, is anything running hot or about to expire. For on-call and network engineers.",
  "tags": [
    "fortiadc",
    "exporter"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
