  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Appliances down",
      "description": "Appliances whose last probe failed on every API call (fortiadc_up = 0). Red when any is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "A",
          "expr": "count(fortiadc_up{job=\"$JOB\", instance=~\"$instance\"} == 0) or vector(0)",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
